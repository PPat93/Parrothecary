# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
build/
next-env.d.ts

# typescript
*.tsbuildinfo

# database — never commit real inventory data
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# backups
backups/

# secrets
.env
.env.local
.env.*.local

# Our actual medicine cabinet stays off git — photos, the transcription, and the
# real seed script all describe what the household takes. scripts/seed.mjs holds
# invented demo data and IS committed.
seed/photos/*
!seed/photos/.gitkeep
seed/my-stock.mjs
seed/catalog.md

# testing — Vitest coverage plus every Playwright artefact.
# These are regenerated on each run and must never be committed.
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# os / editor
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.vscode/
.idea/

# git-bash / msys crash dumps — land in the repo root when a shell dies
*.stackdump

# playwright auth
e2e/.auth